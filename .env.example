# =============================================================================
# Trancones Medellín — variables de entorno
# Copia este archivo a `.env` y completa los valores antes de arrancar:
#   cp .env.example .env
# =============================================================================

# ── Seguridad (obligatorias en producción) ───────────────────────────────────
# Clave HMAC-SHA256 de AL MENOS 32 caracteres para firmar los JWT.
# Generar con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Usuario y contraseña iniciales (la contraseña se guarda con hash BCrypt).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Vida del token JWT en minutos (default 15).
JWT_EXPIRATION_MINUTES=15

# ── Login con Google (OAuth 2.0) ─────────────────────────────────────────────
# Crear credenciales OAuth en https://console.cloud.google.com/apis/credentials
# (Authorized redirect URIs debe incluir GOOGLE_OAUTH_REDIRECT_URI exacto).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
GOOGLE_OAUTH_FRONTEND_REDIRECT=http://localhost:5173

# ── Login por teléfono (OTP) ─────────────────────────────────────────────────
# URL opcional de un proveedor de SMS (webhook). Vacío = el código se muestra
# en el log y en la respuesta (solo desarrollo). En producción pon false.
PHONE_SMS_API_URL=
PHONE_SHOW_DEV_CODE=true


# ── Base de datos y Redis ────────────────────────────────────────────────────
DB_USER=postgres
DB_PASSWORD=postgres
REDIS_HOST=localhost

# ── Fuentes de datos oficiales (tiempo real) ─────────────────────────────────
# TomTom Traffic API — free tier, sin aprobación (recomendada).
# Crear cuenta en https://developer.tomtom.com → Developer API Key.
TOMTOM_API_KEY=
# Google Routes API (Google Cloud, $200/mes gratis en facturación).
GOOGLE_MAPS_API_KEY=
# Waze for Cities (requiere aprobación institucional).
WAZE_API_URL=
# SIMM / Datos abiertos Medellín (CKAN público) — resource_id del dataset
# de sensores de velocidad en https://datosabiertos.medellin.gov.co
SIMM_API_URL=https://datosabiertos.medellin.gov.co/api
SIMM_RESOURCE_ID=
# Segundos entre ciclos de actualización (controla la cuota de TomTom free:
# ~2.500 llamadas/día). Con 300 s ≈ 1.800 llamadas/día.
TRAFFIC_REFRESH_INTERVAL_SECONDS=300

# ── Calidad del aire (WAQI / AQICN) ─────────────────────────────────────────
# Token gratuito en https://aqicn.org/data-platform/token/
# Sin este valor se usa el token "demo" de WAQI (solo pruebas, cuota muy baja).
AIRQUALITY_TOKEN=

# ── Notificaciones Push (VAPID) ──────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── CORS ─────────────────────────────────────────────────────────────────────
# URL exacta del frontend (sin barra final). En Render poner la URL del servicio
# frontend. En local el default http://localhost:5173 se usa automáticamente.
FRONTEND_URL=https://cuello-de-botella.onrender.com
# Para permitir múltiples orígenes, usa CORS_ORIGINS (lista separada por comas).
# Si CORS_ORIGINS está definida, sobreescribe FRONTEND_URL.
# CORS_ORIGINS=https://cuello-de-botella.onrender.com,https://otro-origen.com

# Solo true si el backend está detrás de un proxy de confianza (nginx, ALB)
# que reescribe X-Forwarded-For; se usa esa IP para el rate-limit de login.
TRUST_FORWARDED_FOR=false

# ── Monitoreo (Prometheus + Grafana) ────────────────────────────────────────
# Grafana: usuario/contraseña del admin (obligatorio en producción).
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(24))"
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Puertos de los servicios de monitoreo.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
