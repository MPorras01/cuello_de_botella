    {
      "name": "Notificaciones Push",
      "item": [
        {
          "name": "Suscribirse a notificaciones",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/ejemplo_obtenido_del_navegador\",\n  \"p256dh\": \"BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM\",\n  \"auth\": \"yX1mK0oZ8sW2pQ7vB4nD6fH9jL1cR3tU\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/push/subscribe",
              "host": ["{{baseUrl}}"],
              "path": ["api", "push", "subscribe"]
            },
            "description": "Registra una suscripcion VAPID para recibir notificaciones push cuando hay cuellos de botella severos. El endpoint, p256dh y auth se obtienen de navigator.serviceWorker en el navegador."
          },
          "response": [
            {
              "name": "Suscripcion creada",
              "status": "Created",
              "code": 201,
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"endpoint\": \"https://fcm.googleapis.com/fcm/send/ejemplo\",\n  \"p256dh\": \"BNcRdreALRFXTkOOUHK1EtK2wtaz5Ry4YfYCA_0QTpQtUbVlUls0VJXg7A8u-Ts1XbjhazAkj7I99e8QcYP7DkM\",\n  \"auth\": \"yX1mK0oZ8sW2pQ7vB4nD6fH9jL1cR3tU\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/push/subscribe",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "push", "subscribe"]
                }
              }
            }
          ]
        },
        {
          "name": "Cancelar suscripcion",
