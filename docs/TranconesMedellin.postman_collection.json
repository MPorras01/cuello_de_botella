{
  "info": {
    "_postman_id": "trancones-medellin-2026",
    "name": "Trancones Medellin API",
    "description": "API de Trancones Medellín — detección de cuellos de botella en tiempo real. Todos los endpoints (excepto login) requieren el header `Authorization: Bearer {{token}}`. El script de login guarda el token automáticamente. Base URL: http://localhost:8080",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticacion",
      "item": [
        {
          "name": "Login (guarda el token automaticamente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"prueba\",\n  \"password\": \"prueba123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Unico endpoint publico. Devuelve un JWT que expira a los 15 minutos. El script extrae el token y lo guarda en la variable {{token}} para el resto de la coleccion."
          },
          "response": [
            {
              "name": "Login OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"eyJhbGciOiJIUzM4NCJ9.eyJzdWIiOiJwcnVlYmEiLCJyb2xlIjoiQURNSU4iLCJpYXQiOjE3ODYyMzAzMDksImV4cCI6MTc4NjIzMTIwOX0...\",\n  \"tokenType\": \"Bearer\",\n  \"expiresInSeconds\": 900,\n  \"username\": \"prueba\"\n}",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"prueba\",\n  \"password\": \"prueba123\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            },
            {
              "name": "Credenciales invalidas",
              "status": "Unauthorized",
              "code": 401,
              "body": "{\n  \"error\": \"Credenciales invalidas\"\n}",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"username\": \"prueba\",\n  \"password\": \"incorrecta\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/login",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "login"]
                }
              }
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.token) {",
                  "  pm.collectionVariables.set('token', json.token);",
                  "  console.log('Token guardado:', json.token.substring(0, 25) + '...');",
                  "} else {",
                  "  console.log('Login fallo:', JSON.stringify(json));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Trafico en tiempo real",
      "item": [
        {
          "name": "Stream SSE - trafico en vivo (cada 30s)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/stream/traffic",
              "host": ["{{baseUrl}}"],
              "path": ["api", "stream", "traffic"]
            },
            "description": "Server-Sent Events. Emite un evento `traffic-update` cada 30s con los segmentos (velocidad de las vias), cuellos de botella y alertas de incidentes. En Postman la respuesta se acumula en streaming."
          },
          "response": [
            {
              "name": "Evento SSE de ejemplo",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "text/event-stream"
                }
              ],
              "body": "event: traffic-update\ndata: {\"segments\":[{\"segmentId\":\"av-el-poblado\",\"name\":\"Av. El Poblado\",\"speedKmh\":24,\"freeFlowKmh\":60,\"speedRatio\":0.4,\"status\":\"CONGESTION\",\"lat\":6.2005,\"lng\":-75.5754,\"geometry\":\"LINESTRING(...)\"}],\"bottlenecks\":[{\"segmentId\":\"av-el-poblado\",\"name\":\"Av. El Poblado\",\"status\":\"CONGESTION\",\"speedRatio\":0.4,\"congestionKm\":3.2,\"freeFlowKmh\":60,\"currentSpeedKmh\":24,\"geometry\":\"LINESTRING(...)\"}],\"alerts\":[{\"id\":\"incident-123\",\"type\":\"CLOSURE\",\"severity\":\"MAJOR\",\"description\":\"Cierre por obras en la Autopista Sur\",\"lat\":6.18,\"lng\":-75.59,\"source\":\"tomtom\",\"createdAt\":\"2026-08-08T17:29:00\"}],\"stale\":false}\n\n",
              "originalRequest": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{token}}"
                  },
                  {
                    "key": "Accept",
                    "value": "text/event-stream"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/stream/traffic",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "stream", "traffic"]
                }
              }
            }
          ]
        },
